rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match data is public to read, scorers and admins can write
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Tournament standings and schedules
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Athlete statistics & performance records
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // User profile data
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Crashlytics error logs & push notification subscriptions
    match /crashlytics_reports/{reportId} {
      allow read, write: if true;
    }
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }
  }
}
